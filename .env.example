# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE_URL: URL of your Supabase project (e.g. https://your-project.supabase.co)
SUPABASE_URL=

# SUPABASE_ANON_KEY: Public anonymous key for Supabase client
SUPABASE_ANON_KEY=

# SUPABASE_SERVICE_ROLE_KEY: Private service-role key for backend operations (NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=

# N8N_EMAIL_WEBHOOK_URL: Production webhook URL for n8n ATS email workflows (e.g. recruiter setup, interviews, applications)
N8N_EMAIL_WEBHOOK_URL="https://aqibb.app.n8n.cloud/webhook/ats-email"

# N8N_WEBHOOK_URL: Legacy webhook URL fallback for n8n automation
N8N_WEBHOOK_URL=
